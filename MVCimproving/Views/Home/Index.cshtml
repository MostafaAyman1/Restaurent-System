@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "Admin";
    var userName = User.Identity?.Name ?? "Guest";
}

<div class="dashboard-container">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <!-- Authenticated User/Admin Dashboard -->
        <div class="welcome-section">
            <div class="welcome-content">
                <h1 class="welcome-title">
                    Welcome back, <span class="highlight">@userName</span>
                </h1>
                <p class="welcome-subtitle">
                    @if (isAdmin)
                    {
                        <text>Restaurant Management System - Admin Control Panel</text>
                    }
                    else
                    {
                        <text>Order Your Favorite Meals With Ease</text>
                    }
                </p>
            </div>
        </div>

        @if (isAdmin)
        {
            <!-- Admin Dashboard -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #C9A84C 0%, #E8D5A3 100%);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 11H7v6H9z"/>
                            <path d="M16 8h-2v9h2z"/>
                            <path d="M5 19h14M2 3h20v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V3z"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-label">Total Orders</h3>
                        <p class="stat-value">0</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #3D6B4A 0%, #C6DCCA 100%);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-label">Customers</h3>
                        <p class="stat-value">0</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #8B2635 0%, #F2D5D8 100%);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1"/>
                            <circle cx="20" cy="21" r="1"/>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-label">Menu Items</h3>
                        <p class="stat-value">0</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #C4621A 0%, #F5DECE 100%);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"/>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-label">Revenue</h3>
                        <p class="stat-value">$0</p>
                    </div>
                </div>
            </div>

            <!-- Quick Actions for Admin -->
            <div class="quick-actions">
                <h2 class="section-title">Quick Actions</h2>
                <div class="action-grid">
                    <a asp-controller="Orders" asp-action="Create" class="action-btn action-primary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12h14"/>
                        </svg>
                        Create Order
                    </a>
                    <a asp-controller="MenuItems" asp-action="Create" class="action-btn action-secondary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12h14"/>
                        </svg>
                        Add Menu Item
                    </a>
                    <a asp-controller="Categories" asp-action="Create" class="action-btn action-secondary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12h14"/>
                        </svg>
                        Add Category
                    </a>
                    <a asp-controller="Customers" asp-action="Index" class="action-btn action-secondary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        Manage Customers
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- User Dashboard -->
            <div class="user-dashboard">
                <div class="dashboard-card featured">
                    <div class="card-header">
                        <h2>Ready to Order?</h2>
                        <p>Browse our delicious menu and create your next order</p>
                    </div>
                    <a asp-controller="Orders" asp-action="Create" class="btn-large">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12h14"/>
                        </svg>
                        Create New Order
                    </a>
                </div>

                <div class="dashboard-grid">
                    <div class="dashboard-card">
                        <h3>My Orders</h3>
                        <p class="card-desc">View and manage your orders</p>
                        <a asp-controller="Orders" asp-action="Index" class="card-link">
                            View All Orders
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                        </a>
                    </div>

                    <div class="dashboard-card">
                        <h3>Menu</h3>
                        <p class="card-desc">Browse our menu items</p>
                        <a asp-controller="MenuItems" asp-action="Index" class="card-link">
                            View Menu
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                        </a>
                    </div>

                    <div class="dashboard-card">
                        <h3>Categories</h3>
                        <p class="card-desc">Browse by category</p>
                        <a asp-controller="Categories" asp-action="Index" class="card-link">
                            View Categories
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Unauthenticated User Landing Page -->
        <div class="landing-section">
            <div class="landing-content">
                <h1 class="landing-title">Welcome to Restaurant System</h1>
                <p class="landing-subtitle">Manage your restaurant with ease and efficiency</p>

                <div class="feature-grid">
                    <div class="feature-card">
                        <div class="feature-icon" style="background: linear-gradient(135deg, #C9A84C 0%, #E8D5A3 100%);">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"/>
                                <circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                            </svg>
                        </div>
                        <h3>Order Management</h3>
                        <p>Create and track orders efficiently</p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon" style="background: linear-gradient(135deg, #3D6B4A 0%, #C6DCCA 100%);">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </div>
                        <h3>Customer Management</h3>
                        <p>Keep track of your customers</p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon" style="background: linear-gradient(135deg, #8B2635 0%, #F2D5D8 100%);">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18.364 5.636l-3.536 3.536m9.172-9.172l-3.536 3.536M9 11a4 4 0 11-8 0 4 4 0 018 0zm0 0H3m8-4l4 4m4-8l-4 4"/>
                            </svg>
                        </div>
                        <h3>Menu Management</h3>
                        <p>Organize your menu items</p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon" style="background: linear-gradient(135deg, #C4621A 0%, #F5DECE 100%);">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="1" x2="12" y2="23"/>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                            </svg>
                        </div>
                        <h3>Revenue Tracking</h3>
                        <p>Monitor your business growth</p>
                    </div>
                </div>

                <div class="cta-section">
                    <a asp-controller="Account" asp-action="Login" class="btn-cta primary">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                            <polyline points="10 17 15 12 10 7"/>
                            <line x1="15" y1="12" x2="3" y2="12"/>
                        </svg>
                        Login
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn-cta secondary">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                            <line x1="12" y1="12" x2="12" y2="18"/>
                            <line x1="9" y1="15" x2="15" y2="15"/>
                        </svg>
                        Sign Up
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .dashboard-container {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .welcome-section {
        margin-bottom: 3rem;
        padding: 2.5rem;
        background: linear-gradient(135deg, var(--gold) 0%, var(--amber) 100%);
        border-radius: var(--radius-lg);
        color: white;
        box-shadow: var(--shadow-lg);
    }

    .welcome-content h1 {
        font-family: var(--font-display);
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .welcome-content .highlight {
        font-style: italic;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
    }

    .welcome-subtitle {
        font-size: 1.1rem;
        opacity: 0.95;
        margin: 0;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .stat-card {
        background: white;
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        box-shadow: var(--shadow-sm);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        flex-shrink: 0;
    }

    .stat-info {
        flex: 1;
    }

    .stat-label {
        font-size: 0.9rem;
        color: var(--warm-gray);
        margin: 0 0 0.5rem 0;
        font-weight: 500;
    }

    .stat-value {
        font-family: var(--font-display);
        font-size: 1.8rem;
        color: var(--espresso);
        margin: 0;
        font-weight: 600;
    }

    /* Quick Actions */
    .quick-actions {
        margin-bottom: 3rem;
    }

    .section-title {
        font-family: var(--font-display);
        font-size: 1.8rem;
        color: var(--espresso);
        margin-bottom: 1.5rem;
        font-weight: 600;
    }

    .action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .action-btn {
        padding: 1.2rem 1.5rem;
        border-radius: var(--radius-md);
        border: none;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        text-decoration: none;
        transition: all 0.3s ease;
        font-family: var(--font-body);
    }

    .action-primary {
        background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
        color: white;
    }

    .action-primary:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .action-secondary {
        background: var(--parchment);
        color: var(--espresso);
        border: 2px solid var(--gold);
    }

    .action-secondary:hover {
        background: var(--gold);
        color: white;
        transform: translateY(-2px);
    }

    /* User Dashboard */
    .user-dashboard {
        animation: fadeIn 0.5s ease;
    }

    .dashboard-card {
        background: white;
        border-radius: var(--radius-lg);
        padding: 2rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

    .dashboard-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
    }

    .dashboard-card.featured {
        background: linear-gradient(135deg, var(--gold) 0%, var(--amber) 100%);
        color: white;
        margin-bottom: 2rem;
        text-align: center;
        padding: 3rem 2rem;
    }

    .dashboard-card.featured .card-header h2 {
        font-family: var(--font-display);
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .dashboard-card.featured .card-header p {
        font-size: 1.1rem;
        opacity: 0.95;
    }

    .btn-large {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background: white;
        color: var(--gold-dark);
        padding: 1rem 2rem;
        border-radius: var(--radius-md);
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        font-size: 1rem;
        margin-top: 1.5rem;
        transition: all 0.3s ease;
    }

    .btn-large:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .dashboard-card h3 {
        font-family: var(--font-display);
        font-size: 1.5rem;
        color: var(--espresso);
        margin-bottom: 0.5rem;
    }

    .card-desc {
        color: var(--warm-gray);
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
    }

    .card-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--gold);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .card-link:hover {
        color: var(--gold-dark);
        gap: 0.75rem;
    }

    /* Landing Page */
    .landing-section {
        text-align: center;
        padding: 3rem 2rem;
    }

    .landing-content {
        max-width: 1000px;
        margin: 0 auto;
    }

    .landing-title {
        font-family: var(--font-display);
        font-size: 3rem;
        color: var(--espresso);
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .landing-subtitle {
        font-size: 1.3rem;
        color: var(--warm-gray);
        margin-bottom: 3rem;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .feature-card {
        background: white;
        padding: 2rem;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-lg);
    }

    .feature-icon {
        width: 80px;
        height: 80px;
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        margin: 0 auto 1.5rem;
    }

    .feature-card h3 {
        font-family: var(--font-display);
        font-size: 1.3rem;
        color: var(--espresso);
        margin-bottom: 0.5rem;
    }

    .feature-card p {
        color: var(--warm-gray);
        font-size: 0.95rem;
    }

    .cta-section {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 2.5rem;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: 1.1rem;
        text-decoration: none;
        cursor: pointer;
        border: none;
        transition: all 0.3s ease;
        font-family: var(--font-body);
    }

    .btn-cta.primary {
        background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
        color: white;
    }

    .btn-cta.primary:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
    }

    .btn-cta.secondary {
        background: white;
        color: var(--espresso);
        border: 2px solid var(--gold);
    }

    .btn-cta.secondary:hover {
        background: var(--gold);
        color: white;
        transform: translateY(-2px);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 1rem;
        }

        .welcome-section {
            padding: 1.5rem;
        }

        .welcome-content h1 {
            font-size: 1.8rem;
        }

        .landing-title {
            font-size: 2rem;
        }

        .stats-grid, .action-grid, .dashboard-grid, .feature-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

