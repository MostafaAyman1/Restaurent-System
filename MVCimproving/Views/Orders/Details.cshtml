@model MVCimproving.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<h2>Order Details</h2>

<div>
    <h4>@Model.GetOrderType()</h4>
    <dl class="row">
        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.OrderDate</dd>
        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10">@Model.TotalAmount.ToString("C")</dd>
        <dt class="col-sm-2">Items</dt>
        <dd class="col-sm-10">
            <ul>
            @foreach(var it in Model.OrderItems ?? new List<MVCimproving.Models.OrderItem>()){
                <li>@it.MenuItem?.Name x @it.Quantity (@it.GetTotal().ToString("C"))</li>
            }
            </ul>
        </dd>
    </dl>
</div>

<p>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</p>
