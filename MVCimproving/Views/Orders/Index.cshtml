@model IEnumerable<MVCimproving.Models.Order>

@{
    ViewData["Title"] = "Orders";
    var isAdmin = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "Admin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Orders</h2>
        <a asp-action="Create" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Create New Order
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p>No orders found. <a asp-action="Create">Create your first order</a></p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>@order.GetOrderType()</strong></td>
                            <td>@order.OrderDate.ToString("g")</td>
                            <td class="text-success fw-bold">@order.TotalAmount.ToString("C")</td>
                            <td>
                                @if (order.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (order.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (order.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-type="@order.GetOrderType().Replace("-","")" asp-route-id="@order.Id" class="btn btn-sm btn-info">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    Details
                                </a>
                                @if (order.Status == "Pending")
                                {
                                    @if (isAdmin)
                                    {
                                        <a asp-action="Delete" asp-route-type="@order.GetOrderType().Replace("-","")" asp-route-id="@order.Id" class="btn btn-sm btn-danger">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                            </svg>
                                            Delete
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Cancel" asp-route-type="@order.GetOrderType().Replace("-","")" asp-route-id="@order.Id" class="btn btn-sm btn-warning">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="15" y1="9" x2="9" y2="15"/>
                                                <line x1="9" y1="9" x2="15" y2="15"/>
                                            </svg>
                                            Cancel
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .btn-sm {
        padding: 0.35rem 0.6rem;
        font-size: 0.85rem;
    }

    .btn-sm svg {
        margin-right: 0.25rem;
    }
</style>
